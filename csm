#!/usr/bin/env python3
"""csm — Claude Code session status in tmux. Hook and CLI in one file.

    csm                 the table
    csm jump <N>        jump to that session's window
    csm next            jump to the window that needs you (! -> ? -> v)
    csm watch           refresh every 2s; digits jump, q quits
    csm hook <event>    Claude Code hook (payload is JSON on stdin)
    csm sweep           recompute only (called by tmux status-interval)
    csm tmux-conf       print the block for ~/.tmux.conf
    csm install         hooks + ~/.local/bin/csm symlink + tmux.conf block
    csm install --check report what is missing, change nothing

Hook and table share every rule (state machine, claude-pane detection, pruning),
so they live in one file. When the hook was bash+jq and the table was python, the
same rules were written twice and drifted whenever only one side was changed.

Window name:  ◆<label><glyph>[<tools>][⚙<agents>][·<elapsed>]
  glyphs: · start   ▶ working   ! waiting for you   ? quiet too long   ✓ done

Output language follows $LANG (Korean when it starts with "ko"); CSM_LANG=ko|en
overrides it.
"""
import json, os, select, shutil, subprocess, sys, termios, time, tty

CACHE = os.path.expanduser("~/.cache/claude-tmux")
HOME = os.path.expanduser("~")
SELF = os.path.realpath(__file__)
MARK = "◆"
SHELLS = {"zsh", "bash", "sh", "fish", "tcsh", "ksh", "dash"}
STALL = 180          # a "working" session this quiet, with no tool in flight, is not believed
SWEEP_GAP = 5        # re-entry guard (status-interval fires once per attached client)

# Output language: $LANG decides, CSM_LANG overrides. Keep both tables in step with
# the bash edition - compat-test.sh compares the rendered tables byte for byte.
_LANG = (os.environ.get("CSM_LANG")
         or ("ko" if (os.environ.get("LANG") or "").lower().startswith("ko") else "en"))
_TXT = {
    "en": {"working": "▶ working", "done": "✓ done", "input": "! waiting",
           "stall": "? quiet", "start": "· start", "unknown": "· unknown",
           "hdr": ["#", "state", "window", "tmux", "progress", "last", "cwd", "task"],
           "none": "No Claude session is running.", "sec": "s ago", "min": "m ago",
           "hour": "h ago", "day": "d ago", "mine": "your turn", "workn": "working",
           "unk": "no state yet", "hint": "   —   csm jump <#> / csm next",
           "keys": "1-9 jump · q close", "nosess": "No session is waiting for you.",
           "nonum": "no such row: ", "usage_jump": "usage: csm jump <row>"},
    "ko": {"working": "▶ 작업중", "done": "✓ 완료", "input": "! 응답대기",
           "stall": "? 확인필요", "start": "· 시작", "unknown": "· 상태없음",
           "hdr": ["#", "상태", "window", "tmux", "진행", "마지막", "cwd", "작업"],
           "none": "실행 중인 Claude 세션이 없습니다.", "sec": "초 전", "min": "분 전",
           "hour": "시간 전", "day": "일 전", "mine": "내 차례", "workn": "작업중",
           "unk": "상태없음", "hint": "   —   csm jump <#> / csm next 로 이동",
           "keys": "1-9 이동 · q 닫기", "nosess": "내 차례인 세션이 없습니다.",
           "nonum": "그런 번호가 없습니다: ", "usage_jump": "사용: csm jump <번호>"},
}
TXT = _TXT.get(_LANG, _TXT["en"])
TXT.setdefault("none", _TXT["en"]["none"])
GLYPH = {k: TXT[k] for k in ("working", "done", "input", "stall", "start", "unknown")}
MARKS = {"working": "▶", "done": "✓", "input": "!", "stall": "?",
         "start": "·", "unknown": "·"}
PRIO = {"input": 4, "stall": 3, "done": 2, "working": 1, "start": 0, "unknown": -1}
# State colours. The table is scanned by eye; without colour you end up counting rows.
SGR = {"input": "\033[1;91m", "stall": "\033[1;93m", "done": "\033[1;92m",
       "working": "\033[96m", "start": "\033[37m", "unknown": "\033[90m"}
BOLD, DIM, RST = "\033[1m", "\033[2m", "\033[0m"

# Glyphs like the diamond/triangle/middle-dot are "ambiguous width" in Unicode, so
# terminals draw them 1 or 2 columns wide. Default is 2, matching iTerm2's
# "Treat ambiguous-width characters as double-width". Set CSM_AMBIWIDTH=1 otherwise.
AMBI = 1 if os.environ.get("CSM_AMBIWIDTH") == "1" else 2


def now():
    """Current time. CSM_NOW freezes it so compat-test.sh can compare two runs."""
    v = os.environ.get("CSM_NOW")
    return int(v) if v and v.isdigit() else int(time.time())

# This width table must match the awk function in the bash edition exactly. Using
# unicodedata here would be unmatchable there (the EastAsianWidth table is ~5KB), so
# both sides carry the same trimmed ranges. U+2713 and U+2699 are Neutral = 1 column;
# treating them as ambiguous shifts the two editions apart by one column.
WIDE = ((0x1100, 0x115F), (0x2E80, 0x303E), (0x3041, 0x33FF), (0x3400, 0x4DBF),
        (0x4E00, 0x9FFF), (0xA000, 0xA4CF), (0xAC00, 0xD7A3), (0xF900, 0xFAFF),
        (0xFE30, 0xFE6F), (0xFF00, 0xFF60), (0xFFE0, 0xFFE6), (0x1F300, 0x1FAFF),
        (0x20000, 0x3FFFD))
AMB = ((0x00A1, 0x00FF), (0x2010, 0x203E), (0x2100, 0x2199), (0x2200, 0x22FF),
       (0x2460, 0x24FF), (0x2500, 0x259F), (0x25A0, 0x25FF), (0x2605, 0x2606),
       (0x2640, 0x2640), (0x2642, 0x2642), (0x2660, 0x2665), (0x266A, 0x266F))


def _cw(cp):
    for lo, hi in WIDE:
        if lo <= cp <= hi:
            return 2
    for lo, hi in AMB:
        if lo <= cp <= hi:
            return AMBI
    return 1


# ── tmux ────────────────────────────────────────────────────────────────
def tmux(*args):
    try:
        r = subprocess.run(("tmux",) + args, capture_output=True, text=True)
    except FileNotFoundError:
        return None
    return r.stdout if r.returncode == 0 else None


def have_tmux():
    return shutil.which("tmux") is not None


def tmux_version():
    m = (tmux("-V") or "").split()
    if len(m) < 2:
        return None
    num = "".join(c for c in m[1] if c.isdigit() or c == ".").strip(".").split(".")
    try:
        return (int(num[0]), int(num[1]) if len(num) > 1 else 0)
    except (ValueError, IndexError):
        return None


PANE_FMT = ("#{pane_id}\t#{window_id}\t#{window_index}\t#{pane_current_command}"
            "\t#{window_name}\t#{pane_pid}\t#{pane_current_path}"
            "\t#{@claude_label}\t#{@claude_state}")


def panes():
    """Live panes: id -> dict. One tmux call gets everything we need."""
    out = tmux("list-panes", "-a", "-F", PANE_FMT)
    live = {}
    for line in (out or "").splitlines():
        f = line.split("\t")
        if len(f) >= 9:
            live[f[0]] = {"win": f[1], "idx": f[2], "cmd": f[3], "wname": f[4],
                          "pid": f[5], "path": f[6], "label": f[7], "wstate": f[8]}
    return live


def socket_path():
    """Socket of the tmux server we are talking to. The cache is per server."""
    out = tmux("display-message", "-p", "#{socket_path}")
    return (out or "").strip() or os.environ.get("TMUX", "").split(",")[0]


def claude_panes(live, skip=()):
    """Panes with a live claude process.

    These must be found even without a cache file: sessions started before the hooks
    were installed, or after the cache was cleared, are invisible if you only read the
    cache. One ps call builds the tree; we look for claude below each pane process.
    Panes that already have a cache entry are skipped, so normally there are no
    candidates and ps is never called (the hook sweeps on every event, so what is
    saved here is hook latency).
    """
    cand = [p for p, m in live.items() if m["cmd"] not in SHELLS and p not in skip]
    if not cand:
        return set()
    try:
        out = subprocess.run(["ps", "-eo", "pid=,ppid=,args="],
                             capture_output=True, text=True).stdout
    except Exception:
        return set()
    kids, args = {}, {}
    for line in out.splitlines():
        f = line.strip().split(None, 2)
        if len(f) == 3:
            kids.setdefault(f[1], []).append(f[0])
            args[f[0]] = f[2]

    def is_claude(a):
        exe = a.split()[0] if a.split() else ""
        # the Claude desktop app is not a session
        return (exe.endswith("/claude") or exe == "claude") and not exe.startswith("/Applications/")

    found = set()
    for pane in cand:
        stack, seen = [live[pane]["pid"]], set()
        while stack:
            pid = stack.pop()
            if pid in seen:
                continue
            seen.add(pid)
            if is_claude(args.get(pid, "")):
                found.add(pane)
                break
            stack.extend(kids.get(pid, []))
    return found


def pane_owning():
    """Pane whose process tree contains us, for hooks that get no TMUX_PANE.

    Claude Code can host a session under a daemon-spawned pty (`claude daemon run` ->
    `claude --bg-pty-host`, which is what a resumed or forked session gets): the pane's
    shell is still an ancestor, but TMUX_PANE is not in that environment, so the hook
    used to write nothing at all and the row kept whatever state it had before the
    fork. Walk our parents and take the first pane_pid we meet.

    Only panes of the default server are reachable here - with no TMUX there is nothing
    that names another socket, and a miss just falls back to the old quiet exit.
    """
    live = panes()
    if not live:
        return None, None
    by_pid = {m["pid"]: pane for pane, m in live.items()}
    try:
        out = subprocess.run(["ps", "-eo", "pid=,ppid="],
                             capture_output=True, text=True).stdout
    except Exception:
        return None, None
    parent = {}
    for line in out.splitlines():
        f = line.split()
        if len(f) == 2:
            parent[f[0]] = f[1]
    pid, seen = str(os.getpid()), set()
    while pid and pid not in ("0", "1") and pid not in seen:
        if pid in by_pid:
            return by_pid[pid], socket_path()
        seen.add(pid)
        pid = parent.get(pid)
    return None, None


# ── state cache ────────────────────────────────────────────────────────────
def cache_path(pane):
    return os.path.join(CACHE, pane.lstrip("%") + ".json")


def read_state(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception:
        return None


def write_state(pane, st):
    os.makedirs(CACHE, exist_ok=True)
    tmp = cache_path(pane) + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(st, fh, ensure_ascii=False)
    os.replace(tmp, cache_path(pane))


def collect(prune=True, live=None):
    """Cache + live claude panes -> rows for the table."""
    if live is None:
        live = panes()
    mysock = socket_path()
    if not live:                      # no tmux answer is not proof that everything died
        prune = False
    rows = []
    for fn in sorted(os.listdir(CACHE)) if os.path.isdir(CACHE) else []:
        if not fn.endswith(".json"):
            continue
        path = os.path.join(CACHE, fn)
        pane = "%" + fn[:-5]
        st = read_state(path)
        if st is None:
            continue
        if pane not in live:          # not a pane of this server
            # Written by another tmux server: not ours to delete. (Running csm from a
            # second server once wiped every real session's state.)
            if prune and st.get("socket") and st["socket"] == mysock:
                try: os.unlink(path)
                except OSError: pass
            continue
        m = live[pane]
        if m["cmd"] in SHELLS:                     # claude exited, shell is back
            if prune:
                try: os.unlink(path)
                except OSError: pass
            continue
        state = st.get("state") or "done"
        inflight = int(st.get("pre", 0)) - int(st.get("post", 0))
        ts = int(st.get("ts", 0))
        if state == "working" and inflight <= 0 and now() - ts > STALL:
            state = "stall"
        rows.append({
            "pane": pane, "win": m["win"], "idx": m["idx"], "wname": m["wname"],
            "label": m["label"], "wstate": m["wstate"],
            "state": state, "ts": ts, "inflight": max(0, inflight),
            "turn": int(st.get("turn_ts", 0)), "tools": int(st.get("tools", 0)),
            "tool": st.get("tool") or "",
            "agents": max(0, int(st.get("agents", 0)) - int(st.get("agents_done", 0))),
            "cwd": (st.get("cwd") or "").replace(HOME, "~", 1),
            "sid": st.get("session_id") or "", "task": (st.get("task") or "").strip(),
        })

    # Live claude panes with no cache yet: state unknown, session very much alive.
    seen = {r["pane"] for r in rows}
    for pane in claude_panes(live, skip=seen):
        m = live[pane]
        rows.append({
            "pane": pane, "win": m["win"], "idx": m["idx"], "wname": m["wname"],
            "label": m["label"], "wstate": m["wstate"],
            "state": "unknown", "ts": 0, "inflight": 0, "turn": 0, "tools": 0,
            "tool": "", "agents": 0, "cwd": (m["path"] or "").replace(HOME, "~", 1),
            "sid": "", "task": "",
        })

    rows.sort(key=lambda r: (-PRIO.get(r["state"], 0), r["idx"], r["pane"]))
    for i, r in enumerate(rows, 1):
        r["n"] = i
    return rows


# ── table ──────────────────────────────────────────────────────────────────
def ago(sec):
    d = max(0, now() - int(sec))
    if d < 60:
        return f"{d}{TXT['sec']}"
    if d < 3600:
        return f"{d // 60}{TXT['min']}"
    if d < 86400:
        return f"{d // 3600}{TXT['hour']}"
    return f"{d // 86400}{TXT['day']}"


def dur(sec):
    d = max(0, int(sec))
    if d < 60:
        return f"{d}s"
    if d < 3600:
        return f"{d // 60}m{d % 60:02d}s"
    return f"{d // 3600}h{(d % 3600) // 60:02d}m"


def short(sec):
    """Elapsed time for the window name. Empty below a minute."""
    d = max(0, int(sec))
    if d < 60:
        return ""
    if d < 3600:
        return f"{d // 60}m"
    return f"{d // 3600}h{(d % 3600) // 60:02d}m"


def width(s):
    return sum(_cw(ord(c)) for c in s)


def pad(s, n):
    return s + " " * max(0, n - width(s))


def clip(s, n):
    """Clip to a display width and append an ellipsis."""
    if n <= 0 or width(s) <= n:
        return s
    out, w = "", 0
    for c in s:
        cw = width(c)
        if w + cw > n - 1:
            break
        out, w = out + c, w + cw
    return out + "…"


def render(rows, color=None):
    if color is None:
        color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    paint = (lambda t, c: f"{c}{t}{RST}") if color else (lambda t, c: t)

    if not rows:
        return TXT["none"] + "\n"
    hdr = list(TXT["hdr"])
    body = []
    for r in rows:
        if r["state"] in ("working", "stall"):
            prog = str(r["tools"])
            if r["agents"]:
                prog += f" ⚙{r['agents']}"
            if r["turn"]:
                prog += f" {dur(now() - r['turn'])}"
            if r["tool"]:
                prog += f" {r['tool']}{'…' if r['inflight'] else ''}"
        else:
            prog = "-"
        body.append([str(r["n"]), GLYPH.get(r["state"], "? " + r["state"]),
                     r["wname"], f"{r['idx']}.{r['pane']}", prog,
                     ago(r["ts"]) if r["ts"] else "-",
                     r["cwd"], r["task"] or "-"])
    cols = [max(width(row[i]) for row in [hdr] + body) for i in range(len(hdr))]
    # The task column gets whatever width is left; prompts are long enough to wrap the table.
    term = max(shutil.get_terminal_size((120, 24)).columns or 120, 60)
    room = term - (sum(cols[:-1]) + 2 * len(cols) - 2) - 1
    cols[-1] = max(10, min(cols[-1], room))
    for row in body:
        row[-1] = clip(row[-1], cols[-1])

    out = [paint("  ".join(pad(c, w) for c, w in zip(hdr, cols)).rstrip(), BOLD),
           paint("─" * max(10, min(term - 1, sum(cols) + 2 * (len(cols) - 1))), DIM)]
    for r, row in zip(rows, body):
        cells = [pad(c, w) for c, w in zip(row, cols)]
        c = SGR.get(r["state"], "")
        cells[0] = paint(cells[0], DIM)          # row number
        cells[1] = paint(cells[1], c)            # state
        cells[2] = paint(cells[2], c)            # window - same colour or it does not catch the eye
        cells[-1] = paint(cells[-1], DIM)        # task (the prompt)
        out.append("  ".join(cells).rstrip())

    mine = [r for r in rows if r["state"] in ("input", "done", "stall")]
    unknown = sum(1 for r in rows if r["state"] == "unknown")
    out.append("")
    out.append(f"{TXT['mine']}: {len(mine)} · {TXT['workn']}: "
               f"{sum(1 for r in rows if r['state'] == 'working')}"
               + (f" · {TXT['unk']}: {unknown}" if unknown else "")
               + paint(TXT["hint"], DIM))
    return "\n".join(out) + "\n"


def goto(rows, n):
    for r in rows:
        if r["n"] == n:
            tmux("select-window", "-t", r["win"])
            tmux("select-pane", "-t", r["pane"])
            return True
    return False


# ── window names and tab colours ──────────────────────────────────────────────────────
def strip_glyphs(name):
    n = name[len(MARK):] if name.startswith(MARK) else name
    n = n.split("×", 1)[0]
    for g in "▶✓!?·⚙":
        n = n.split(g, 1)[0]
    return n


def update_windows(rows, live):
    """Bring window names and @claude_state up to date. Names you chose are kept."""
    by_win = {}
    for r in rows:
        by_win.setdefault(r["win"], []).append(r)

    for win in {m["win"] for m in live.values()}:
        meta = next(m for m in live.values() if m["win"] == win)
        mine = by_win.get(win)
        if not mine:
            # no claude pane left -> restore the original name
            if meta["label"] or meta["wstate"]:
                tmux("set-option", "-w", "-t", win, "-u", "@claude_label")
                tmux("set-option", "-w", "-t", win, "-u", "@claude_state")
                if meta["wname"] != meta["label"]:
                    tmux("rename-window", "-t", win, meta["label"])
                tmux("set-option", "-w", "-t", win, "automatic-rename", "on")
            continue

        top = max(mine, key=lambda r: (PRIO.get(r["state"], 0), r["ts"]))
        label = meta["label"]
        if not label:
            wname = meta["wname"]
            if wname.startswith(MARK):
                label = strip_glyphs(wname)
            elif wname in ("node", "claude", "zsh", "bash", "sh", "fish", ""):
                label = ""
            else:
                label = wname
            label = label or os.path.basename(top["cwd"].rstrip("/")) or "claude"
            tmux("set-option", "-w", "-t", win, "@claude_label", label)

        detail = ""
        if top["state"] == "working":
            if top["tools"]:
                detail = str(top["tools"])
            if top["agents"]:
                detail += f"⚙{top['agents']}"
            if top["turn"]:
                e = short(now() - top["turn"])
                if e:
                    detail += f"·{e}"
        suffix = f"×{len(mine)}" if len(mine) > 1 else ""
        target = f"{MARK}{label}{suffix}{MARKS.get(top['state'], '·')}{detail}"

        if meta["wname"] != target:
            tmux("rename-window", "-t", win, target)
        if meta["wstate"] != top["state"]:
            tmux("set-option", "-w", "-t", win, "@claude_state", top["state"])


def summary(rows):
    out = ""
    for state, g in (("input", "!"), ("stall", "?"), ("done", "✓"),
                     ("working", "▶"), ("unknown", "·")):
        n = sum(1 for r in rows if r["state"] == state)
        if n:
            out += f"{g}{n} "
    return out.strip()


def sweep(force=False):
    """Recompute and refresh window names. status-interval fires once per client, so
    re-entry is guarded.

    The stamp and the summary are per server: sharing one file lets a second tmux
    server's sweep overwrite the real server's summary with someone else's numbers.
    """
    os.makedirs(CACHE, exist_ok=True)
    tag = os.path.basename(socket_path() or "default") or "default"
    stamp = os.path.join(CACHE, f".sweep-{tag}")
    cached = os.path.join(CACHE, f".summary-{tag}")
    if not force:
        try:
            if now() - float(open(stamp).read().strip()) < SWEEP_GAP:
                try: return open(cached).read()
                except OSError: return ""
        except (OSError, ValueError):
            pass
    try:
        with open(stamp, "w") as fh:
            fh.write(str(now()))
    except OSError:
        pass
    live = panes()
    rows = collect(live=live)
    update_windows(rows, live)
    s = summary(rows)
    try:
        with open(cached, "w") as fh:
            fh.write(s)
    except OSError:
        pass
    return s


# ── hook ──────────────────────────────────────────────────────────────────
def advance(prev):
    """Where a completion event (PostToolUse / SubagentStop) moves the state.

    These are the tail end of work that already finished and can arrive after Stop,
    so they must not resurrect a finished turn (a SubagentStop landing after Stop used
    to leave a done window stuck at "working"). PreToolUse is work that is starting,
    so that one is allowed to revive.
    """
    return "done" if prev == "done" else "working"


def hook(event):
    if not have_tmux():
        return 0                      # outside tmux: pass quietly, a hook must not fail the turn
    pane = os.environ.get("TMUX_PANE")
    sock = os.environ.get("TMUX", "").split(",")[0]
    if not pane:                      # daemon-hosted session: the env is gone, the tree is not
        pane, sock = pane_owning()
    if not pane:
        return 0
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except Exception:
        payload = {}

    prev = read_state(cache_path(pane)) or {}
    ts_now = now()
    st = {
        "pane": pane,
        "socket": sock or prev.get("socket") or "",
        "state": prev.get("state") or "",
        "session_id": payload.get("session_id") or prev.get("session_id") or "",
        "cwd": payload.get("cwd") or prev.get("cwd") or os.getcwd(),
        "ts": ts_now,
        "turn_ts": int(prev.get("turn_ts", 0)),
        "tools": int(prev.get("tools", 0)),
        "tool": prev.get("tool") or "",
        "agents": int(prev.get("agents", 0)),
        "agents_done": int(prev.get("agents_done", 0)),
        "pre": int(prev.get("pre", 0)),
        "post": int(prev.get("post", 0)),
        "task": prev.get("task") or "",
    }
    tool = payload.get("tool_name") or ""

    if event in ("start", "working"):          # new turn - the only done -> working transition
        st.update(state="working", turn_ts=ts_now, tools=0, agents=0, agents_done=0,
                  pre=0, post=0, tool="")
        # what this turn was asked to do = one line of the prompt; the task column shows it
        prompt = " ".join((payload.get("prompt") or "").split())
        if prompt:
            st["task"] = prompt[:120]
    elif event == "tool":                      # PreToolUse - actually working right now
        if st["state"] == "done":              # some turns start without a prompt event
            st.update(turn_ts=ts_now, tools=0, agents=0, agents_done=0, pre=0, post=0)
        st["pre"] += 1
        st["tools"] += 1
        st["tool"] = tool
        if tool in ("Task", "Agent"):
            st["agents"] += 1
        # tools that always wait for a human go straight to "waiting"
        st["state"] = "input" if tool in ("AskUserQuestion", "ExitPlanMode") else "working"
        if not st["turn_ts"]:
            st["turn_ts"] = ts_now
    elif event == "tooldone":                  # PostToolUse
        st["post"] += 1
        if tool:
            st["tool"] = tool
        st["state"] = advance(prev.get("state"))
    elif event == "agent":                     # SubagentStop
        st["agents_done"] += 1
        st["state"] = advance(prev.get("state"))
    elif event == "done":                      # Stop
        st["state"] = "done"
    elif event == "input":                     # Notification
        # only permission/approval prompts count; the 60s idle notice changes nothing
        msg = (payload.get("message") or "").lower()
        # Korean strings kept: Claude Code localises this notification.
        keys = ("ermission", "pprove", "confirm", "권한", "승인")
        st["state"] = "input" if any(k.lower() in msg for k in keys) else (prev.get("state") or "done")
    elif event == "end":                       # SessionEnd
        try: os.unlink(cache_path(pane))
        except OSError: pass
        sweep(force=True)
        return 0
    else:
        return 0

    write_state(pane, st)
    sweep(force=True)                          # reflect it in names and tab colours now
    return 0


# ── tmux.conf block ───────────────────────────────────────────────────────
BEGIN, END = "# >>> csm >>>", "# <<< csm <<<"
# Older marker name; installs clean it out of confs that still carry it.
OLD_BEGIN, OLD_END = "# >>> claude-agents tmux-state >>>", "# <<< claude-agents tmux-state <<<"


def splice(body, block):
    """Replace only the marked region, dropping an old-marker block if present."""
    for b, e in ((OLD_BEGIN, OLD_END), (BEGIN, END)):
        if b in body and e in body:
            head, rest = body.split(b, 1)
            body = head + rest.split(e, 1)[1]
    body = body.rstrip("\n")
    return (body + "\n\n" if body else "") + block + "\n"


def tmux_conf(ver=None):
    """The block to paste into ~/.tmux.conf, trimmed to what this tmux can do."""
    ver = ver or tmux_version() or (99, 0)
    csm = SELF
    L = [BEGIN,
         "# Written by csm. Do not edit here - re-run `csm tmux-conf` instead.",
         "#",
         "# status-right shows the totals (! waiting / ? quiet / ✓ done / ▶ working / · unknown).",
         "# The sweep also refreshes elapsed times and the quiet-too-long check.",
         "set -g status-interval 5",
         f"set -g status-right '#[fg=colour39]#({csm} sweep)#[fg=white] %H:%M %d-%b-%y'"]
    if ver >= (3, 1):
        L += ["",
              "# Tab colour per state. csm sets @claude_state as a window option.",
              "#   ! red / ? yellow / ✓ green / · grey (unknown) / ▶ and no-claude keep their colour",
              "# The current window is left to window-status-current-format so you never lose",
              "# track of where you are.",
              'set -g window-status-format "#{?#{==:#{@claude_state},input},'
              '#[fg=colour231#,bg=colour160#,bold],#{?#{==:#{@claude_state},stall},'
              '#[fg=colour232#,bg=colour214#,bold],#{?#{==:#{@claude_state},done},'
              '#[fg=colour232#,bg=colour35#,bold],#{?#{==:#{@claude_state},unknown},'
              '#[fg=colour250#,bg=colour240],#[fg=white#,bg=colour234]}}}}#I.#W"']
    else:
        L += ["", "# Tab colours need #{==:...}, which is tmux 3.1+. Window-name glyphs stand in below that."]
    L += ["", "# C-a L pops csm up over the screen. Digits jump, q closes."]
    if ver >= (3, 2):
        L += ["unbind L", f'bind-key L display-popup -E -w 90% -h 80% "{csm} watch"']
    else:
        L += ["unbind L", f'bind-key L new-window -n csm "{csm} watch"']
    L.append(END)
    return "\n".join(L) + "\n"


# ── install ────────────────────────────────────────────────────────────────
HOOKS = [("SessionStart", "start"), ("UserPromptSubmit", "working"),
         ("PreToolUse", "tool"), ("PostToolUse", "tooldone"),
         ("SubagentStop", "agent"), ("Notification", "input"),
         ("Stop", "done"), ("SessionEnd", "end")]
SETTINGS = os.path.expanduser("~/.claude/settings.json")
OK, WARN, FAIL = "  ✓", "  ⚠", "  ✗"


def install(check=False):
    bad = []
    os.chmod(SELF, 0o755)

    # 1) ~/.local/bin/csm symlink
    bindir = os.path.join(HOME, ".local", "bin")
    link = os.path.join(bindir, "csm")
    cur = os.path.realpath(link) if os.path.lexists(link) else None
    if cur == SELF:
        print(OK, "csm — already linked")
    elif check:
        print(WARN, "csm symlink missing"); bad.append("csm")
    else:
        os.makedirs(bindir, exist_ok=True)
        if os.path.lexists(link):
            os.unlink(link)
        os.symlink(SELF, link)
        print(OK, f"csm — symlink {'replaced' if cur else 'created'}: {link}")
    if bindir not in os.environ.get("PATH", "").split(os.pathsep):
        print(WARN, f"{bindir} is not on PATH — add it in your shell config")

    # 2) hooks. Only entries that call csm are touched; everything else is left alone.
    data = {}
    if os.path.exists(SETTINGS):
        try:
            data = json.load(open(SETTINGS))
        except Exception as e:
            print(FAIL, f"settings.json is not valid JSON — hooks not registered: {e}")
            return 1
    hooks = data.setdefault("hooks", {})
    changed = []
    for event, arg in HOOKS:
        want = f"{SELF} hook {arg}"
        groups = hooks.setdefault(event, [])
        found = False
        for g in groups:
            for h in g.get("hooks", []):
                cmd = h.get("command", "")
                if "csm" not in cmd and "tmux-state.sh" not in cmd:
                    continue
                found = True
                if cmd != want or h.get("async") is not True:
                    h["command"], h["async"], h["type"] = want, True, "command"
                    changed.append(event)
        if not found:
            groups.append({"hooks": [{"type": "command", "command": want, "async": True}]})
            changed.append(event)
    if not changed:
        print(OK, "settings.json hooks — up to date")
    elif check:
        print(WARN, f"hooks missing or stale: {', '.join(sorted(set(changed)))}"); bad.append("hooks")
    else:
        os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
        with open(SETTINGS, "w") as fh:
            json.dump(data, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        os.chmod(SETTINGS, 0o600)
        print(OK, f"settings.json hooks — registered: {', '.join(sorted(set(changed)))}")

    # 3) ~/.tmux.conf block. Only the marked region is replaced, never your own config.
    conf = os.path.join(HOME, ".tmux.conf")
    block = tmux_conf().rstrip("\n")
    body = open(conf).read() if os.path.exists(conf) else ""
    new = splice(body, block)
    if new == body:
        print(OK, ".tmux.conf — up to date")
    elif check:
        print(WARN, ".tmux.conf block not applied"); bad.append(".tmux.conf")
    else:
        if body:                       # keep something to restore if the splice goes wrong
            with open(conf + ".csm-bak", "w") as fh:
                fh.write(body)
        with open(conf, "w") as fh:
            fh.write(new)
        print(OK, ".tmux.conf — block applied" + (f" (previous file: {conf}.csm-bak)" if body else ""))
        # Only reload when this really is the running user's home. With HOME overridden
        # (sandbox, test) the conf we just wrote is not the one that server reads, and
        # sourcing it would push our settings onto someone else's session.
        try:
            import pwd
            real_home = pwd.getpwuid(os.getuid()).pw_dir
        except Exception:
            real_home = HOME
        if HOME == real_home and (os.environ.get("TMUX") or tmux("has-session") is not None):
            tmux("source-file", conf)
            print(OK, "tmux config reloaded")

    if bad:
        print(FAIL, "not installed:", ", ".join(bad))
        return 1
    print(OK, "done — new Claude sessions will report their state.")
    return 0


# ── entry point ──────────────────────────────────────────────────────────────
def watch():
    if not sys.stdout.isatty():          # piped (e.g. a Bash tool call): never loop forever
        sys.stdout.write(render(collect()))
        return 0
    fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    saved = termios.tcgetattr(fd) if fd is not None else None
    try:
        if fd is not None:
            tty.setcbreak(fd)
        while True:
            rows = collect()
            sys.stdout.write("\033[H\033[2J" + render(rows) + "\n" + TXT["keys"] + "\n")
            sys.stdout.flush()
            if fd is None:
                time.sleep(2)
                continue
            if not select.select([fd], [], [], 2)[0]:
                continue
            ch = os.read(fd, 1).decode("utf-8", "ignore")
            if ch in ("q", "Q", "\x1b", "\x03"):
                break
            if ch.isdigit() and ch != "0" and goto(rows, int(ch)):
                break                     # jumped: close (a popup just disappears)
    except KeyboardInterrupt:
        pass
    finally:
        if saved is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "list"
    if cmd in ("list", "-1", "--once"):
        sys.stdout.write(render(collect()))
    elif cmd == "jump":
        if len(argv) < 3 or not argv[2].isdigit():
            sys.exit(TXT["usage_jump"])
        if not goto(collect(), int(argv[2])):
            sys.exit(TXT["nonum"] + argv[2])
    elif cmd == "next":
        rows = collect()
        pick = next((r for r in rows if r["state"] == "input"), None) \
            or next((r for r in rows if r["state"] == "stall"), None) \
            or next((r for r in rows if r["state"] == "done"), None)
        if not pick:
            sys.exit(TXT["nosess"])
        goto(rows, pick["n"])
    elif cmd == "watch":
        return watch()
    elif cmd == "hook":
        if len(argv) < 3:
            sys.exit("usage: csm hook <start|working|tool|tooldone|agent|input|done|end>")
        return hook(argv[2])
    elif cmd == "sweep":
        if not have_tmux():
            return 0
        sys.stdout.write(sweep())
    elif cmd in ("tmux-conf", "conf"):
        sys.stdout.write(tmux_conf())
    elif cmd == "install":
        return install(check="--check" in argv)
    elif cmd in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
    else:
        sys.exit("usage: csm [list|jump <#>|next|watch|hook <event>|sweep|tmux-conf|install]")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except BrokenPipeError:
        pass
    except Exception as e:                     # a hook must never fail the turn
        if len(sys.argv) > 1 and sys.argv[1] in ("hook", "sweep"):
            sys.exit(0)
        raise SystemExit(f"csm: {e}")
